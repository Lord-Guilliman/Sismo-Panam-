# Copia este archivo a un almacén de variables de entorno del proveedor (NO lo subas con valores reales).
# Sitio de GitHub Pages: escribe solo el origen, sin la ruta /sismo-panama/.
ALLOWED_ORIGINS=https://TU_USUARIO.github.io
PUBLIC_APP_URL=https://TU_USUARIO.github.io/sismo-panama/

# Genera el par VAPID con: python backend/generate_vapid.py --output-ruta-segura
VAPID_PUBLIC_KEY=PEGA_AQUI_LA_CLAVE_PUBLICA_GENERADA
VAPID_PRIVATE_KEY_PATH=/ruta/privada/vapid_private.pem
VAPID_SUBJECT=mailto:TU_CORREO_REAL

# El vigilante consulta el catálogo USGS desde el backend. Mantén false hasta configurar
# las variables anteriores y validar la instancia. Intervalo mínimo admitido: 30 segundos.
ENABLE_MONITOR=false
POLL_SECONDS=30
MAX_SUBSCRIPTIONS=1000
SISMO_DB_PATH=/ruta/persistente/sismo_push.sqlite3
LOG_LEVEL=INFO
